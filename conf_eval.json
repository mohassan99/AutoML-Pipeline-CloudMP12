{
  "ProcessingJobName": "{% $states.input.id & '-evaluation' %}",
  "RoleArn": "arn:aws:iam::635245520742:role/mp12-sagemaker-role",
  "AppSpecification": {
    "ImageUri": "683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:0.23-1-cpu-py3",
    "ContainerEntrypoint": [
      "python3"
    ],
    "ContainerArguments": [
      "/opt/ml/processing/input/code/evaluate.py",
      "{% 's3://models-zengrit/staging/' & $states.input.id & '-training/output/model.tar.gz' %}",
      "s3://datasets-zengrit/test/",
      "--test-file",
      "/opt/ml/processing/input/data/combined_test.csv"
    ]
  },
  "ProcessingResources": {
    "ClusterConfig": {
      "InstanceCount": 1,
      "InstanceType": "ml.t3.medium",
      "VolumeSizeInGB": 10
    }
  },
  "ProcessingInputs": [
    {
      "InputName": "code",
      "S3Input": {
        "S3Uri": "s3://scripts-zengrit/",
        "LocalPath": "/opt/ml/processing/input/code",
        "S3DataType": "S3Prefix",
        "S3InputMode": "File"
      }
    },
    {
      "InputName": "data",
      "S3Input": {
        "S3Uri": "s3://datasets-zengrit/test/",
        "LocalPath": "/opt/ml/processing/input/data",
        "S3DataType": "S3Prefix",
        "S3InputMode": "File"
      }
    }
  ],
  "ProcessingOutputConfig": {
    "Outputs": [
      {
        "OutputName": "evaluation",
        "S3Output": {
          "S3Uri": "s3://models-zengrit/staging/",
          "LocalPath": "/opt/ml/processing/output",
          "S3UploadMode": "EndOfJob"
        }
      }
    ]
  }
}